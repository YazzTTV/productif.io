# Exemple de variables d'environnement nécessaires
# Ne stockez pas de vraies valeurs ici, ceci est juste un exemple
# Renommez ce fichier en .env.local pour l'utilisation locale

# Base de données
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"

# NextAuth
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"

# JWT
JWT_SECRET="your-jwt-secret"

# Google OAuth - Web
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Google OAuth - Mobile iOS
GOOGLE_MOBILE_CLIENT_ID_IOS="your-ios-client-id.apps.googleusercontent.com"

# Google RISC (Risk and Incident Sharing and Coordination)
# Liste des audiences acceptées pour les tokens RISC (client IDs OAuth séparés par des virgules)
# Exemple : "web-client-id.apps.googleusercontent.com,ios-client-id.apps.googleusercontent.com"
GOOGLE_RISC_AUDIENCES="your-google-web-client-id.apps.googleusercontent.com"

# Compte de service Google pour RISC (JSON encodé en base64)
# Mettre le JSON complet du compte de service dans cette variable, encodé en base64.
# Exemple : GOOGLE_SERVICE_ACCOUNT_JSON_B64="$(base64 -w0 Productifio\ IAM.json)"
GOOGLE_SERVICE_ACCOUNT_JSON_B64="base64-encoded-service-account-json"

# API URL
NEXT_PUBLIC_API_URL="https://www.productif.io"

# Stripe (si utilisé)
STRIPE_SECRET_KEY="your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="your-stripe-webhook-secret"

# OpenAI
OPENAI_API_KEY="sk-your-openai-api-key"

# WhatsApp Business API
WHATSAPP_ACCESS_TOKEN="your-whatsapp-access-token"
WHATSAPP_VERIFY_TOKEN="your-whatsapp-verify-token"
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"

# Resend — envoi d'emails (scan planning, session)
RESEND_API_KEY="re_xxxxxxxx"
# Optionnel : email d'envoi (domaine vérifié sur Resend)
# SCAN_FROM_EMAIL="Productif <noreply@productif.io>"

# Autres variables spécifiques à votre application 