# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Secrets / credentials
Productifio IAM.json
*.credentials.json

# dependencies
/node_modules

# next.js
/.next/
/out/

# expo (etat local de dev, identifiants d'appareil)
.expo/

# macOS
.DS_Store

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# mais pas .env.example qui doit être versionné
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# temporary files
/temp/
temp/
*.tmp
*.temp
.env.railway

# Firebase service account (clé privée - ne jamais commiter)
firebase-service-account.json
*firebase*service*account*.json
*Firebase*Admin*SDK*.json
**/Productifio Firebase Admin SDK.json

# Firebase google-services.json (contient des clés API)
**/google-services.json
mobile-app-new/android/app/google-services.json
android/app/google-services.json
mobile-app-new/firebase/GoogleService-Info.plist
mobile-app-new/ios/Productifio/GoogleService-Info.plist

# Keystore files (clés de signature - ne jamais commiter)
*.keystore
*.jks
# exception : keystore de debug Android, public par conception (mot de passe "android")
!mobile-app-new/android/app/debug.keystore
*.jks
**/productif-upload.keystore
productif-upload.keystore

# Fichiers contenant des valeurs Firebase pour Railway (contiennent des clés privées)
RAILWAY_FIREBASE_VALUES.txt
*RAILWAY*FIREBASE*.txt
