{
  "compilerOptions": {
    "target": "es2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "baseUrl": ".",
    "rootDir": ".",
    "outDir": "dist"
  },
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "mobile-app-new",
    "mobile-app",
    "scripts",
    "Discipline System Design",
    "Productif.io Design App (1)",
    "productif.io design app for computer",
    "app/api/debug/**",
    "app/api/companies/**",
    "app/api/waitlist/**",
    "app/dashboard/admin/**",
    "app/onboarding/page.old.tsx",
    "components/features-section.tsx",
    "components/pricing-section.tsx",
    "components/testimonials-section.tsx",
    "components/dashboard/new-dashboard.tsx",
    "components/dashboard/overview-metrics.tsx",
    "components/dashboard/recent-tasks.tsx",
    "components/dashboard-section.tsx",
    "components/trial/**",
    "lib/i18n.tsx",
    "lib/utils/TextNormalizer.ts"
  ]
}
